pipeline { 
agent any 
    stages { 
 
        stage('Clone Code') { 
            steps { 
                git branch: 'main', url:https://github.com/aarthiganesan2805-web/jenkins-demoo/blob/main/aarthi.java
            } 
        } 
 
        stage('Compile Code') { 
            steps { 
                bat 'javac aarthi.java' 
            } 
        } 
 
        stage('Run Code') { 
            steps { 
                bat 'java aarthi' 
            } 
        } 
 
    } 
}
